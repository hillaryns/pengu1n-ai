# Copy this file to .env and set your own API keys.
# Never commit real secrets. Values in .env are loaded automatically
# when the FastAPI application starts (via python-dotenv).
#
# Multiple keys are supported as a comma-separated list:
# PENGU1N_API_KEYS=key-one,key-two
PENGU1N_API_KEYS=change-this-development-key

# Optional AI-assisted report enhancement (disabled by default).
# Keep this false unless you intentionally enable a future LLM provider.
# No external AI API calls are made while disabled / unconfigured.
PENGU1N_AI_REPORT_ENABLED=false
# PENGU1N_AI_API_KEY=
# PENGU1N_AI_PROVIDER=none
